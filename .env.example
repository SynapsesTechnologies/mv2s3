# mvimg2s3 Environment Variables Example

# Source scanning
MVIMG2S3_SOURCE_DIR=./website
MVIMG2S3_FILE_EXTENSIONS=html,css,js,md,jsx,tsx

# AWS S3 Configuration
MVIMG2S3_S3_BUCKET=my-website-images
MVIMG2S3_S3_REGION=us-east-1
MVIMG2S3_S3_PREFIX=images/

# AWS Credentials (alternative to AWS profile)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_PROFILE=default

# Processing Options
MVIMG2S3_DRY_RUN=false
MVIMG2S3_CLEANUP_LOCAL=false
MVIMG2S3_BACKUP_ORIGINALS=true
MVIMG2S3_BACKUP_DIR=./backups
MVIMG2S3_CONCURRENCY=5

# Logging
MVIMG2S3_LOG_LEVEL=info
MVIMG2S3_VERBOSE=false
